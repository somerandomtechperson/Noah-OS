# Build output
/build/

# Generated ISO images
*.iso

# Temporary inspection files
noahos-inspection.tar.gz
noahos-iso-audit.txt

# Logs and temporary files
*.log
*.tmp
*~

# Python-generated files
__pycache__/
*.py[cod]

# Arch package build artifacts
**/pkg/
**/*.pkg.tar.*

# makepkg downloaded sources and extraction directory
/infrastructure/packages/noahos-update-agent/src/
/infrastructure/packages/noahos-update-agent/noahos-update-check.service
/infrastructure/packages/noahos-update-agent/noahos-update-check.timer

# NoahOS signing keys: publish only the public key files
infrastructure/keys/*
!infrastructure/keys/noahos-package-signing.asc
!infrastructure/keys/noahos.gpg
